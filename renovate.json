{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    "docker:enableMajor",
    "schedule:daily",
    ":automergeBranch",
    ":automergeDigest",
    ":automergePatch",
    ":disableDependencyDashboard"
  ],
  "labels": ["dependencies"],
  "reviewers": ["Nitestack"],
  "timezone": "Europe/Berlin",
  "nix": {
    "enabled": true
  },
  "pinDigests": true,
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track digest-pinned OCI images referenced in Nix modules",
      "managerFilePatterns": ["/(^|/).*\\.nix$/"],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "image\\s*=\\s*(?:lib\\.mkDefault\\s*)?\"(?<depName>(?:[\\w.-]+(?::\\d+)?/)*[\\w.-]+):[\\w.-]+@sha256:[a-f0-9]{64}\"",
        "(?<currentValue>[\\w.-]+)@(?<currentDigest>sha256:[a-f0-9]{64})"
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": "{{{newValue}}}@{{{newDigest}}}"
    },
    {
      "customType": "regex",
      "description": "Track unpinned OCI image tags referenced in Nix homelab modules",
      "managerFilePatterns": [
        "/(^|/)configurations/nixos/[^/]+/homelab/.*\\.nix$/",
        "/(^|/)modules/nixos/homelab/.*\\.nix$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "image\\s*=\\s*(?:lib\\.mkDefault\\s*)?\"(?<depName>(?:[\\w.-]+(?::\\d+)?/)*[\\w.-]+):[\\w.-]+\"",
        ":(?<currentValue>[\\w.-]+)\""
      ],
      "datasourceTemplate": "docker",
      "versioningTemplate": "docker",
      "autoReplaceStringTemplate": ":{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\""
    },
    {
      "customType": "regex",
      "description": "Track npm plugins configured for OpenCode",
      "managerFilePatterns": ["/(^|/)modules/home/opencode/.*\\.nix$/"],
      "matchStrings": [
        "(?<depName>@[\\w.-]+/[\\w.-]+|[\\w.-]+)@(?<currentValue>v?\\d+(?:\\.\\d+){1,2}(?:[-+][0-9A-Za-z.-]+)?)"
      ],
      "datasourceTemplate": "npm",
      "versioningTemplate": "npm",
      "autoReplaceStringTemplate": "{{{depName}}}@{{{newValue}}}"
    }
  ],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "addLabels": ["docker"]
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/nextcloud-releases/all-in-one"],
      "enabled": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/^ghcr\\.io/immich-app/immich-(server|machine-learning)$/"
      ],
      "groupName": "Immich"
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": [
        "/^ghcr\\.io/seanmorley15/adventurelog-(frontend|backend)$/"
      ],
      "groupName": "Adventure Log"
    }
  ]
}
