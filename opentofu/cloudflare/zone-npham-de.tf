# npham.de: Proton Mail, Vercel projects, and (until the homelab moves to
# nhanph.am) the homelab wildcard into the Cloudflare Tunnel.
locals {
  npham_de = {
    name    = "npham.de"
    zone_id = "9691fb68dda1b46eaac63b8f8af58328"
  }

  npham_de_records = {
    # Homelab: every app with expose.mode = "public" is reachable through this
    # wildcard; ingress is generated by modules/nixos/homelab/cloudflared.nix.
    tunnel_wildcard = { type = "CNAME", name = "*", content = local.tunnel_target, proxied = true }

    # Vercel
    apex_vercel              = { type = "A", name = "@", content = "216.198.79.1", comment = "Personal Site (on Vercel)" }
    chart_bar_solid          = { type = "CNAME", name = "chart-bar-solid", content = "cname.vercel-dns.com", comment = "Chart Bar in SolidJS" }
    interactive_rating_solid = { type = "CNAME", name = "interactive-rating-solid", content = "cname.vercel-dns.com", comment = "Interactive Rating in SolidJS" }
    nft_preview_card_solid   = { type = "CNAME", name = "nft-preview-card-solid", content = "cname.vercel-dns.com", comment = "NFT Preview Card in SolidJS" }
    players_alliance         = { type = "CNAME", name = "players-alliance", content = "cname.vercel-dns.com", comment = "Players Alliance" }
    qr_code_solid            = { type = "CNAME", name = "qr-code-solid", content = "cname.vercel-dns.com", comment = "QR Code in SolidJS" }
    tic_tac_toe              = { type = "CNAME", name = "tic-tac-toe", content = "cname.vercel-dns.com", comment = "Tic Tac Toe (School Project)" }
    tip_calculator_solid     = { type = "CNAME", name = "tip-calculator-solid", content = "cname.vercel-dns.com", comment = "Tip Calculator in SolidJS" }

    # Proton Mail
    proton_mx_primary   = { type = "MX", name = "@", content = "mail.protonmail.ch", priority = 10, comment = "Proton Mail" }
    proton_mx_secondary = { type = "MX", name = "@", content = "mailsec.protonmail.ch", priority = 20, comment = "Proton Mail" }
    proton_verification = { type = "TXT", name = "@", content = "\"protonmail-verification=6fd7be751db9281709c350781238c2fee5d07bf4\"", comment = "Proton Mail" }
    proton_spf          = { type = "TXT", name = "@", content = "\"v=spf1 include:_spf.protonmail.ch ~all\"", comment = "Proton Mail" }
    proton_dmarc        = { type = "TXT", name = "_dmarc", content = "\"v=DMARC1; p=quarantine\"", comment = "Proton Mail" }
    proton_dkim_1       = { type = "CNAME", name = "protonmail._domainkey", content = "protonmail.domainkey.donc42jnjohpwmeaoi6rppuun5lvemd4ulmai3zvcmqe5wfynpjba.domains.proton.ch", comment = "Proton Mail" }
    proton_dkim_2       = { type = "CNAME", name = "protonmail2._domainkey", content = "protonmail2.domainkey.donc42jnjohpwmeaoi6rppuun5lvemd4ulmai3zvcmqe5wfynpjba.domains.proton.ch", comment = "Proton Mail" }
    proton_dkim_3       = { type = "CNAME", name = "protonmail3._domainkey", content = "protonmail3.domainkey.donc42jnjohpwmeaoi6rppuun5lvemd4ulmai3zvcmqe5wfynpjba.domains.proton.ch", comment = "Proton Mail" }
  }
}

module "npham_de_baseline" {
  source = "./modules/zone-baseline"

  zone_id         = local.npham_de.zone_id
  zone_name       = local.npham_de.name
  caa_iodef_email = local.caa_iodef_email
}

resource "cloudflare_dns_record" "npham_de" {
  for_each = local.npham_de_records

  zone_id  = local.npham_de.zone_id
  name     = each.value.name == "@" ? local.npham_de.name : "${each.value.name}.${local.npham_de.name}"
  type     = each.value.type
  content  = each.value.content
  priority = lookup(each.value, "priority", null)
  proxied  = lookup(each.value, "proxied", false)
  comment  = lookup(each.value, "comment", null)
  ttl      = 1 # automatic; required when proxied
}
